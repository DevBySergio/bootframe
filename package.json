{
  "name": "bootframe",
  "displayName": "BootFrame",
  "description": "Visual Bootstrap layout builder for VS Code",
  "icon": "media/bootframe.png",
  "publisher": "DevBySergio",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DevBySergio/bootframe"
  },
  "version": "1.2.0",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Snippets"
  ],
  "activationEvents": [
    "onView:bootframe.builder",
    "onCommand:bootframe.openBuilder",
    "onCommand:bootframe.resetBuilder"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "bootframe",
          "title": "BootFrame",
          "icon": "media/bootframe.svg"
        }
      ]
    },
    "views": {
      "bootframe": [
        {
          "id": "bootframe.builder",
          "name": "Builder",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "bootframe.openBuilder",
        "title": "Open BootFrame Builder"
      },
      {
        "command": "bootframe.resetBuilder",
        "title": "Reset BootFrame Design",
        "icon": "$(discard)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "bootframe.resetBuilder",
          "when": "view == bootframe.builder",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "BootFrame",
      "properties": {
        "bootframe.defaultVersion": {
          "type": "string",
          "enum": [
            "5",
            "4"
          ],
          "default": "5",
          "description": "Default Bootstrap version for new layouts"
        },
        "bootframe.defaultOutputMode": {
          "type": "string",
          "enum": [
            "snippet",
            "full-html"
          ],
          "default": "snippet",
          "description": "Default output mode for generated code"
        },
        "bootframe.indentSize": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "maximum": 8,
          "description": "Number of spaces for indentation in generated HTML"
        },
        "bootframe.maxUndoHistory": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "maximum": 200,
          "description": "Maximum number of undo steps"
        },
        "bootframe.includeBootstrapJS": {
          "type": "boolean",
          "default": false,
          "description": "Include Bootstrap JS bundle when generating complete HTML documents"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
